{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StreambinS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::streambin/files/*"
    },
    {
      "Sid": "StreambinS3List",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::streambin"
    }
  ]
}
